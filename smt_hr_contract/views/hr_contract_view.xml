<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_inherit" model="ir.ui.view">
        <field name="name">hr_contract.hr_employee_view_form.inherited</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <!-- Add classification after the hr_responsible_id field (Settings tab) -->
            <xpath expr="//page[@name='hr_settings']//group[@name='managers']/field[@name='hr_responsible_id']" position="after">
                <field name="classification_id" string="Classification"/>
            </xpath>
            <!-- Add salary breakdown in the Payroll tab, after the schedule separator -->
            <xpath expr="//page[@name='payroll_information']//group[@name='contract']//separator[@name='schedule']" position="after">
                <separator string="Salary Breakdown"/>
                <field name="base_salary"/>
                <label for="hourly_salary"/>
                <div class="o_row" name="hourly_row">
                    <field name="hourly_salary" nolabel="1"/>
                    <span> / hour</span>
                </div>
                <field name="month_12_last_salary"/>
                <field name="allow_transport"/>
                <field name="allow_family"/>
                <field name="allow_logement"/>
                <field name="other_allow"/>
            </xpath>
            <!-- Hide the standard wage row since wage is computed from base_salary -->
            <xpath expr="//page[@name='payroll_information']//div[@name='wage']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
