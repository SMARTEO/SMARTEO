<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="rule_mail_activity_creator_only" model="ir.rule">
            <field name="name">Action: Editing/deletion restricted to the creator</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="perm_read">0</field>
            <field name="perm_create">0</field>
            <field name="perm_write">1</field>
            <field name="perm_unlink">1</field>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('smt_base.group_activity_manager') or user.has_group('base.group_system') else [('create_uid', '=', user.id)]</field>
        </record>
    </data>
</odoo>
