<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="res_partner_contact_inherited" model="ir.ui.view">
            <field name="name">res.partner.inherited</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <field name="vat" position="after">
                    <field name="nif" />
                    <field name="stat" />
                    <field name="rcs" />
                    <field name="cif" />
                </field>
                <xpath expr="//page[@name='sales_purchases']" position="inside">
                    <group string="Informations contacts">
                        <group>
                            <field name="customer"/>
                            <field name="supplier"/>
                            <field name="compete"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//sheet/div/div/div" position="inside">
                    <div class="d-flex align-items-baseline w-md-50">
                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone" />
                        <field name="phone1" class="w-100" widget="phone" placeholder="Téléphone1" />
                    </div>
                    <div class="d-flex align-items-baseline w-md-50">
                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone" />
                        <field name="phone2" class="w-100" widget="phone" placeholder="Téléphone2" />
                    </div>
                    <div class="d-flex align-items-baseline w-md-50">
                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone" />
                        <field name="phone3" class="w-100" widget="phone" placeholder="Téléphone3" />
                    </div>
                </xpath>

                <xpath expr="//templates/t/main/div[2]" position="after">
                    <div t-if="record.phone.raw_value">
                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Téléphone1" />
                        <field name="phone1" />
                    </div>
                    <div t-if="record.phone.raw_value">
                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Téléphone2" />
                        <field name="phone2" />
                    </div>
                    <div t-if="record.phone.raw_value">
                        <i class="fa fa-fw me-1 fa-phone text-primary" title="Téléphone3" />
                        <field name="phone3" />
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
