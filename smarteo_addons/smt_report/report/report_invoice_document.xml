<?xml version="1.0" encoding="UTF-8"?>

<odoo>

  <template id="style_boxed" inherit_id="web.external_layout_boxed">
    <xpath expr="//div[1]" position="inside">
      <style>
        * {
        font-size: 15px !important;
        }
        .o_company_logo_big {
        width: 104px;
        margin-top: -9px;
        }
        .header {
        padding-bottom: 5px !important;
        border-bottom: 1px solid #e9ecef !important;
        }
        div[name="company_address"] * {
        color: #495057 !important;
        }
        div[name="company_address_list"] strong,
        div[name="company_address"] strong {
        font-weight: 900 !important;
        }
        .o_company_tagline {
        font-family: italic !important;
        white-space: nowrap;
        font-family: Lato !important;
        padding-right: 0 !important;
        }
        .header .o_company_tagline * {
        font-size: 12px !important;
        padding-bottom: 4px !important;
        }
      </style>
    </xpath>
    <xpath expr="//div[3]" position="inside">
      <style>
        * {
        color: #495057;
        font-size: 9px !important;
        }
        .o_footer_content .page,
        .o_footer_content .topage {
        font-size: 10px !important;
        }
        .o_footer_content {
        padding-top: 17px !important;
        border-top: 3px solid #000 !important;
        line-height: 1.8;
        }
      </style>
    </xpath>
  </template>

  <template id="report_invoice_document_preview" inherit_id="account.report_invoice_document">
    <xpath expr="//div[@id='total']/div[hasclass('ms-auto')]" position="attributes">
      <attribute name="style">padding: 0 !important;</attribute>
    </xpath>

    <xpath expr="//div[hasclass('page')]" position="inside">
      <style>
        * {
        font-family: arial;
        line-height: 1.5;
        }
        .address *,
        .invoice_tbody td,
        .invoice_tbody th {
        color: #495057 !important;
        font-size: 15px !important;
        }
        .grey-text {
        color: #6e6e6e !important;
        }
        #informations p,
        #payment_term span {
        color: #000 !important;
        }
        #informations {
        margin-bottom: 32px !important;
        display: table;
        width: 100%;
        }
        #informations > div {
        display: table-cell;
        width: auto;
        }
        #right-elements {
        width: 33% !important;
        margin-top: 15px !important;
        }
        .o_total * {
        color: #fff !important;
        }
        .table td {
        color: #495057 !important;
        padding: 5px !important;
        }
        .table th {
        padding: 5px !important;
        padding: 5px 5px 2px !important;
        font-weight: 700;
        color: #495057 !important;
        }
        .address {
        padding-top: 15px !important;
        }
        .o_portal_address *,
        div[name="address"] * {
        font-weight: 400 !important;
        }
        .o_subtotal td:last-child {
        border-left-color: #fff !important;
        }

        .o_subtotal td:first-child {
        border-right-color: #fff !important;
        }
        .o_total_table .fw-bold td, .o_total_table .fw-bold td span {
        color: #000 !important;
        background-color: #fff;
        }
        .invoice_tbody tr:not(:last-child) td {
        border-bottom: none !important;
        }
      </style>
    </xpath>

    <!-- 2. Colonne de GAUCHE (information_block) : libellé livraison en français (cas où la
         livraison diffère de la facturation ; bloc standard shipping_address_block du base). -->
    <xpath expr="//div[@name='shipping_address_block']/strong" position="replace">
      <strong class="d-block mt-3">Adresse de livraison:</strong>
    </xpath>

    <!-- 2. Cas livraison = facturation : le base v19 ne définit le information_block (bloc gauche)
         que lorsque l'adresse de livraison diffère. On le définit ici pour le cas identique afin
         d'afficher l'adresse de livraison à gauche (comme en v15) ; l'adresse principale reste à droite. -->
    <xpath expr="//div[@name='address_same_as_shipping']" position="inside">
      <t t-set="information_block">
        <div t-if="o.partner_shipping_id">
          <strong class="d-block mt-3">Adresse de livraison:</strong>
          <div t-field="o.partner_shipping_id"
               t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </div>
      </t>
    </xpath>

    <!-- 1 + 3. Bloc NIF/STAT/RCS/CIF affiché SYSTÉMATIQUEMENT dans le bloc adresse principal
         (colonne de droite), livraison identique ou non. Style aligné sur le devis : libellés non
         gras, "NIF : / STAT :" sur une ligne, "RCS : / CIF :" sur une ligne, valeurs non sécables.
         Chaque ligne uniquement si renseignée ; rien si aucun champ. -->
    <xpath expr="//div[@name='address_not_same_as_shipping']/t[@t-set='address']" position="inside">
      <div class="o_partner_fiscal_info mt-1"
           t-if="o.partner_id.nif or o.partner_id.stat or o.partner_id.rcs or o.partner_id.cif">
        <div t-if="o.partner_id.nif or o.partner_id.stat">
          <span t-if="o.partner_id.nif">NIF :
            <span t-field="o.partner_id.nif"/>
          </span>
          <span t-if="o.partner_id.nif and o.partner_id.stat">/</span>
          <span t-if="o.partner_id.stat">STAT :
            <span t-field="o.partner_id.stat"/>
          </span>
        </div>
        <div t-if="o.partner_id.rcs or o.partner_id.cif">
          <span t-if="o.partner_id.rcs">RCS :
            <span t-field="o.partner_id.rcs"/>
          </span>
          <span t-if="o.partner_id.rcs and o.partner_id.cif">/</span>
          <span t-if="o.partner_id.cif">CIF :
            <span t-field="o.partner_id.cif"/>
          </span>
        </div>
      </div>
    </xpath>
    <xpath expr="//div[@name='address_same_as_shipping']/t[@t-set='address']" position="inside">
      <div class="o_partner_fiscal_info mt-1"
           t-if="o.partner_id.nif or o.partner_id.stat or o.partner_id.rcs or o.partner_id.cif">
        <div t-if="o.partner_id.nif or o.partner_id.stat">
          <span t-if="o.partner_id.nif">NIF :
            <span t-field="o.partner_id.nif"/>
          </span>
          <span t-if="o.partner_id.nif and o.partner_id.stat">/</span>
          <span t-if="o.partner_id.stat">STAT :
            <span t-field="o.partner_id.stat"/>
          </span>
        </div>
        <div t-if="o.partner_id.rcs or o.partner_id.cif">
          <span t-if="o.partner_id.rcs">RCS :
            <span t-field="o.partner_id.rcs"/>
          </span>
          <span t-if="o.partner_id.rcs and o.partner_id.cif">/</span>
          <span t-if="o.partner_id.cif">CIF :
            <span t-field="o.partner_id.cif"/>
          </span>
        </div>
      </div>
    </xpath>

    <!-- 3 (rappel tâche précédente). Bloc informations : libellés FR exacts v15, ":" isolé -->
    <xpath expr="//div[@id='informations']" position="replace">
      <div id="informations" class="row mt-2 mb-2" style="font-size: 14px;">
        <div class="col-auto mw-100 mb-1" t-if="o.invoice_date" name="invoice_date">
          <strong>Date de la facture:</strong>
          <p class="m-0" t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
        </div>
        <div class="col-auto mw-100 mb-1" t-if="o.ref" name="reference">
          <strong>Référence:</strong>
          <p class="m-0" t-field="o.ref"/>
        </div>
        <div class="col-auto mw-100 mb-1"
             t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'"
             name="due_date">
          <strong>Date d'échéance:</strong>
          <p class="m-0" t-esc="o.invoice_date_due.strftime('%d/%m/%Y')"/>
        </div>
        <div class="col-auto mw-100 mb-1" t-if="o.invoice_origin" name="origin">
          <strong>Origine:</strong>
          <p class="m-0" t-field="o.invoice_origin"/>
        </div>
        <div class="col-auto mw-100 mb-1" t-if="o.partner_id.ref" name="customer_code">
          <strong>Numéro de client:</strong>
          <p class="m-0" t-field="o.partner_id.ref"/>
        </div>
      </div>
    </xpath>

    <xpath expr="//table[hasclass('o_main_table')]/thead/tr/th[3]" position="replace">
      <th name="th_priceunit"
          t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
        <span>Prix unitaire HT</span>
      </th>
    </xpath>

    <!-- Densité : en-têtes et corps du tableau compacts (11px) -->
    <xpath expr="//table[hasclass('o_main_table')]/thead/tr[1]" position="attributes">
      <attribute name="style">font-size: 11px !important; text-transform: uppercase !important;
        font-weight: 700 !important;
      </attribute>
    </xpath>

    <xpath expr="//table[hasclass('o_main_table')]/tbody" position="attributes">
      <attribute name="style">font-size: 11px !important;</attribute>
    </xpath>

    <xpath expr="//table[hasclass('o_main_table')]/thead/tr/th[2]" position="attributes">
      <attribute name="style">width: 80px; text-align: center;</attribute>
    </xpath>

    <!-- Montant en lettres — INCHANGÉ -->
    <xpath expr="//div/t[@t-set='payment_term_details']" position="before">
      <!-- <div t-att-class="'col-8' if report_type != 'html' else 'col-sm-5 col-md-7'"> -->
      <div>
        <strong style="font-size: 13px !important;" class="grey-text">Arrêté la presente facture à la somme de</strong>
        &#160;
        <span style="font-size: 13px !important;"
              t-esc="o.currency_id.with_context(lang=o.partner_id.lang or 'en_US').amount_to_text(o.amount_total).upper()"/>
        &#160;
      </div>
      <!-- </div> -->
    </xpath>

    <!-- Suppression de la note de conditions de paiement ("100% à la commande"), absente en v15 -->
    <xpath expr="//span[@id='payment_terms_note_id']" position="replace"/>

    <!-- "Lors de votre paiement..." — INCHANGÉ -->
    <xpath expr="//div/p[@name='payment_communication']" position="replace">
      <p name="payment_communication">
        <b style="font-size: 13px !important;">Lors de votre paiement, merci d'indiquer le numéro de votre
          facture :
        </b>
        <span style="font-size: 13px !important;" class="fw-bold"
              t-field="o.payment_reference">INV/2023/00001
        </span>
        <t t-if="o.partner_bank_id">
        </t>
      </p>
    </xpath>
    <xpath expr="//div[hasclass('page')]" position="attributes">
      <attribute name="style">padding-top:1px !important; color :black !important;</attribute>
    </xpath>

  </template>

  <template id="document_tax_totals_template_inherit" inherit_id="account.document_tax_totals_template">
    <xpath expr="//tr/td" position="replace">
      <td>
        <strong class="grey-text" style="font-size:16px;">Montant HT</strong>
      </td>
    </xpath>

    <!-- Densité : totaux compacts (14px / paddings réduits) -->
    <xpath expr="//tr[hasclass('o_subtotal')]/td" position="attributes">
      <attribute name="style">padding: 2px 6px !important; font-size: 14px !important; line-height: 1.2;</attribute>
    </xpath>
    <xpath expr="//tr[hasclass('o_subtotal')]/td[hasclass('text-end')]" position="attributes">
      <attribute name="style">padding: 2px 6px !important; font-size: 14px !important; line-height: 1.2;</attribute>
    </xpath>

    <xpath expr="//tr[hasclass('o_taxes')]/t/td" position="attributes">
      <attribute name="style">padding: 2px 6px !important; font-size: 14px !important; line-height: 1.2;</attribute>
    </xpath>
    <xpath expr="//tr[hasclass('o_taxes')]/t/td[hasclass('o_price_total')]" position="attributes">
      <attribute name="style">padding: 2px 6px !important; font-size: 14px !important; line-height: 1.2;</attribute>
    </xpath>

    <xpath expr="//tr[hasclass('o_total')]/td" position="attributes">
      <attribute name="style">padding: 2px 6px !important; font-size: 14px !important; line-height: 1.2;</attribute>
    </xpath>
    <xpath expr="//tr[hasclass('o_total')]/td[hasclass('text-end')]" position="attributes">
      <attribute name="style">padding: 2px 6px !important; font-size: 14px !important; line-height: 1.2;</attribute>
    </xpath>
  </template>
</odoo>
