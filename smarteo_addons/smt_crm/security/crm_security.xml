<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Global rule (no groups) so it is always AND-ed in, regardless of any
             permissive group rule (e.g. "All Leads") the user may also hold. -->
        <record id="crm_lead_rule_restricted_stage" model="ir.rule">
            <field name="name">Hide Leads/Opportunities in Restricted Stages</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[('stage_id.restricted_user_ids', 'not in', [user.id])]</field>
        </record>
    </data>
</odoo>
