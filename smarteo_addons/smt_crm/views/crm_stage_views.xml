<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="crm_stage_form_inherit" model="ir.ui.view">
            <field name="name">crm.stage.inherit</field>
            <field name="model">crm.stage</field>
            <field name="inherit_id" ref="crm.crm_stage_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='is_won']" position="after">
                    <field name="is_lost"/>
                </xpath>
                <xpath expr="//field[@name='requirements']" position="after">
                    <notebook>
                        <page string="Visibility" name="visibility">
                            <group>
                                <field name="restricted_user_ids" string="Hide for" widget="many2many_tags"
                                    placeholder="Visible to everyone"
                                    help="Users listed here cannot see this stage or its leads/opportunities anywhere in the CRM."/>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

        <record id="crm_stage_tree_inherit" model="ir.ui.view">
            <field name="name">crm.stage.tree.inherit</field>
            <field name="model">crm.stage</field>
            <field name="inherit_id" ref="crm.crm_stage_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='is_won']" position="after">
                    <field name="is_lost"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
