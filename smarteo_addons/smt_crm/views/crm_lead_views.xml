<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default "Leads" (Pistes) to Kanban for every user, matching the existing
         behavior of "Pipeline" (crm.crm_lead_action_pipeline is already Kanban-first). -->
    <record id="crm.crm_lead_all_leads" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,graph,pivot,calendar,form,activity</field>
    </record>

    <record id="crm.crm_lead_all_leads_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
    </record>

    <record id="crm.crm_lead_all_leads_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
    </record>
</odoo>
