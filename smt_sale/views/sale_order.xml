<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']/div" position="attributes">
                <attribute name="groups">base.group_user</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='date_order']" position="attributes">
                <attribute name="groups">base.group_user</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="update_all_margin" type="object" string="Update Margins" invisible="1"/>
            </xpath>
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="string">Unit Price (excl. tax)</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][2]" position="attributes">
                <attribute name="groups">smt_sale.group_hide_security</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][1]" position="attributes">
                <attribute name="groups">smt_sale.group_hide_security</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='name']" position="before">
                <field name="is_set_desc_lines" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='name']" position="attributes">
                <attribute name="readonly">not is_set_desc_lines</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced > 0 or not is_set_desc_lines</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='tax_id']" position="attributes">
                <attribute name="readonly">qty_invoiced > 0 or not is_set_desc_lines</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="readonly">not is_set_desc_lines</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]/button[last()]" position="after">
                <button class="oe_stat_button" name="action_open_crm" string="CRM" type="object"
                    icon="fa-user" invisible="not opportunity_id"/>
            </xpath>
        </field>
    </record>

    <record id="sale_view_inherit123_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_crm.sale_view_inherit123"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='opportunity_id']" position="attributes">
                <attribute name="groups"></attribute>
            </xpath>
        </field>
    </record>
</odoo>
